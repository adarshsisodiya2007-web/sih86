# ==============================================================================
# VARSHANET — Convective Weather Intelligence & 0–6 Hour Nowcasting System
# Problem Statement: SIH26084 | Environment Configuration Reference
# ==============================================================================
#
# NOTE ON OPERATIONAL CREDENTIALS:
# VARSHANET separates LIVE_DATA and SIMULATION modes strictly.
# In LIVE_DATA mode, public APIs (Open-Meteo, NOAA/WMO METAR, RainViewer Doppler)
# run out-of-the-box without requiring API keys.
#
# Institutional/Proprietary feeds (IMD DWR, ISRO MOSDAC INSAT, IITM Damini GLDN)
# require authorized governmental or enterprise credentials.
# If these environment variables are omitted, VARSHANET marks the adapters as
# "AUTH REQUIRED" or "NOT CONNECTED", and does NOT fabricate live data.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ISRO / MOSDAC Geostationary Satellite Feeds (INSAT-3D / INSAT-3DR)
# ------------------------------------------------------------------------------
# Official MOSDAC Single Sign-On (SSO) credentials for automated mdapi acquisition.
# Registration Portal: https://www.mosdac.gov.in
# mdapi software distribution: https://www.mosdac.gov.in/software/mdapi.zip
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
MOSDAC_DATASET_ID=3RIMG_L2B_IMC
MOSDAC_AUTO_DOWNLOAD=true
MOSDAC_DOWNLOAD_INTERVAL_MIN=15

# ------------------------------------------------------------------------------
# 2. IMD / MoES Doppler Weather Radar (DWR) Operational Gateway
# ------------------------------------------------------------------------------
# Secure MoES / IMD VPN Gateway endpoint and Bearer Token / Client Certificate.
# Required for real-time ingest of raw S/C-Band polar volume scans (ODIM HDF5 / WMO BUFR).
# Authorization: Ministry of Earth Sciences (MoES) / IMD Radar Division.
DWR_GATEWAY_URL=
DWR_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 3. Ground Lightning Detection Network (GLDN / IITM Damini TOA Feeds)
# ------------------------------------------------------------------------------
# MQTT Broker / WSS feed endpoint and authentication token for Time-of-Arrival (TOA) strokes.
# Authorization: Indian Institute of Tropical Meteorology (IITM) Lightning Network.
LIGHTNING_FEED_URL=
DAMINI_BROKER_KEY=

# ------------------------------------------------------------------------------
# 4. Public Live Weather Feeds (Pre-configured, Active in LIVE_DATA mode)
# ------------------------------------------------------------------------------
# Seamless ECMWF/GFS Numerical Soundings (Free Tier, rate limited)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# RainViewer Global Doppler Composite Mosaic API
RAINVIEWER_API_URL=https://api.rainviewer.com/public/weather-maps.json

# ------------------------------------------------------------------------------
# 5. Application Server Configuration
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
LOG_LEVEL=info
DEFAULT_OPERATING_MODE=SIMULATION
